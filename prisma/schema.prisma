generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // CastleHub profile. handle is claimed during onboarding.
  handle        String?   @unique
  headline      String?
  bio           String?
  website       String?
  skills        String[]  @default([])
  slackTeamId   String?
  // Set by an admin: a suspended user can read but not post, comment, react or publish.
  suspendedAt   DateTime?
  // Shown on the profile and filterable in search.
  openToCollab  Boolean   @default(false)
  // IANA zone ("Asia/Karachi") deciding which calendar day a build counts for; null = UTC.
  timezone      String?
  // Build streak summary, recalculated from BuildDay whenever a day is added or removed.
  // The current streak is derived on read: the run only counts if streakEnd is today or yesterday.
  streakLength  Int       @default(0)
  streakEnd     DateTime? @db.Date
  longestStreak Int       @default(0)
  activeDays    Int       @default(0)
  // World Map (opt-in). Only a country and optionally a city id from our place list are stored;
  // the map shows the city or country centre, never a precise location.
  countryCode   String?
  cityId        Int?
  onWorldMap    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  posts          Post[]
  projectUpvotes ProjectUpvote[]
  postReactions  PostReaction[]
  comments       Comment[]
  collaborations ProjectCollaborator[]
  notifications  Notification[]        @relation("recipient")
  notified       Notification[]        @relation("actor")
  buildDays      BuildDay[]
  milestones     StreakMilestone[]

  @@index([streakEnd])
  @@index([onWorldMap, countryCode])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Projects ───────────────────────────────────────────────

enum ProjectType {
  GAME
  WEBSITE
  AI_TOOL
  MUSIC
  ART
  VIDEO
  OTHER
}

model Project {
  id          String      @id @default(cuid())
  ownerId     String
  slug        String
  name        String
  tagline     String
  description String
  type        ProjectType
  tags        String[]    @default([])
  websiteUrl  String?
  // Optional video/audio/game link shown as an embed or play button.
  mediaUrl    String?
  iconUrl     String?
  // ISO week ("2026-W43") when entered into the Launchpad; null = Discover only.
  launchWeek  String?
  // The build day this project credited (null if it earned no credit).
  buildDay    DateTime?   @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        ProjectImage[]
  upvotes       ProjectUpvote[]
  posts         Post[]
  comments      Comment[]
  collaborators ProjectCollaborator[]
  notifications Notification[]

  @@unique([ownerId, slug])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([launchWeek])
}

model ProjectImage {
  id        String @id @default(cuid())
  projectId String
  url       String
  position  Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectUpvote {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

// ── Feed ───────────────────────────────────────────────────

model Post {
  id        String    @id @default(cuid())
  authorId  String
  body      String
  imageUrl  String?
  projectId String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  // The build day this post credited (null if it earned no credit, e.g. a duplicate).
  buildDay  DateTime? @db.Date

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reactions     PostReaction[]
  comments      Comment[]
  notifications Notification[]

  @@index([createdAt])
  @@index([authorId, createdAt])
}

enum ReactionKind {
  UPVOTE
  SHIP_IT
  NEED_THIS
  HOW
}

model PostReaction {
  userId    String
  postId    String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId, kind])
  @@index([postId])
}

// People who built a project with its owner. They're credited, not editors.
model ProjectCollaborator {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// ── Comments ───────────────────────────────────────────────

// A comment belongs to exactly one post or one project (checked in the action).
model Comment {
  id        String    @id @default(cuid())
  authorId  String
  body      String
  postId    String?
  projectId String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post          Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([postId, createdAt])
  @@index([projectId, createdAt])
}

// ── Admin ──────────────────────────────────────────────────

// Every admin action, with a snapshot of what it touched (deleted rows are gone).
model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  adminHandle String?
  action      String // delete_post, delete_comment, delete_project, suspend, unsuspend
  targetId    String
  summary     String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ── Notifications ──────────────────────────────────────────

enum NotificationKind {
  POST_COMMENT
  PROJECT_COMMENT
  POST_REACTION
  PROJECT_UPVOTE
  MENTION
  COLLABORATOR_ADDED
  STREAK_MILESTONE
}

// Written by the action that caused it; the bell polls the unread count (no sockets).
model Notification {
  id         String           @id @default(cuid())
  userId     String
  actorId    String
  kind       NotificationKind
  postId     String?
  projectId  String?
  commentId  String?
  // For STREAK_MILESTONE: the milestone reached, in days.
  streakDays Int?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user    User     @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ── Build streaks ──────────────────────────────────────────

// One row per builder per calendar day (in their timezone) with qualifying activity.
// The primary key makes double-crediting a day impossible, even with concurrent posts.
model BuildDay {
  userId String
  day    DateTime @db.Date
  count  Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// Milestones are awarded once per builder; the key makes awards idempotent.
model StreakMilestone {
  userId    String
  days      Int
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, days])
}
