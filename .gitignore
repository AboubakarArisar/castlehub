# ── Dependencies ────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js / build output ──────────────────────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts
.turbo
.vercel

# ── Environment & secrets ───────────────────────────────────
# Real env files never get committed; .env.example documents the keys.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── Prisma / local data ─────────────────────────────────────
# Local image uploads (dev storage) and any SQLite dev databases.
/uploads
*.db
*.db-journal
/prisma/dev.db*

# ── Testing & coverage ──────────────────────────────────────
/coverage
/playwright-report
/test-results
/blob-report

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── Editors & OS ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Local tooling ───────────────────────────────────────────
.claude/settings.local.json
.cache

/src/generated/prisma

# Launch trailer (separate Remotion project, renders and assets)
/trailer
