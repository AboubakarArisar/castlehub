# Copy to .env for local development. Set the same keys in Vercel → Settings → Environment Variables.

# Postgres (Prisma Postgres or Neon). Must be a postgres:// URL, not prisma+postgres://.
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"
# Optional: a direct (unpooled) URL for migrations, e.g. Neon's non-pooler host.
DATABASE_URL_UNPOOLED=""

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""

# Slack app → "Sign in with Slack" (OpenID Connect).
# Redirect URL to register in the Slack app: https://<your-domain>/api/auth/callback/slack
AUTH_SLACK_ID=""
AUTH_SLACK_SECRET=""
# Only members of this Slack workspace can sign in (starts with T). Required in production.
SLACK_TEAM_ID=""

# Vercel Blob for image uploads. Without it, development stores files in ./uploads.
BLOB_READ_WRITE_TOKEN=""

# Development only: "1" shows an email-only dev login on /signin (Slack can't redirect to http://localhost).
AUTH_DEV_LOGIN=""
